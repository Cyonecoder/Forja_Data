# ============ LLM CONFIG (LOCAL ONLY: Ollama/vLLM) ============
# api_key is a dummy value required only by the OpenAI-compatible client.
# No cloud API (api.openai.com) is used.
SUPERVISOR_LLM_URL=http://localhost:11434/v1
SUPERVISOR_LLM_MODEL=qwen3:14b
SUPERVISOR_LLM_API_KEY=ollama

JUDGE_LLM_URL=http://localhost:11434/v1
JUDGE_LLM_MODEL=qwen3:14b
JUDGE_LLM_API_KEY=ollama

LLM_PROVIDER=ollama

# ============ APP CONFIG ============
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=dev

# ============ LANGFUSE (optional, disabled by default) ============
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ============ AUTH ============
AUTH_TOKEN=dev-token

# ============ KAFKA CONFIG ============
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_EVENTS=ga4.events

# ============ GOLD / ANALYTICS POSTGRES (READ-ONLY) ============
# The gold tables live in the external snrt_stats DB used by the pipeline tests.
# Point PG_HOST at the real host and supply a read-only password via your .env.
PG_HOST=localhost
PG_PORT=5432
PG_DB=snrt_stats
PG_USER=snrt_readonly
PG_PASSWORD=CHANGE_ME_READONLY_SECRET
PG_CONNECT_TIMEOUT=5

# ============ DB CONFIG ============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forja
DB_USER=forja_user
DB_PASSWORD=forja_password

DATABASE_URL=
AGENT_DATABASE_URL=
